-- ── SHARED STATE ──────────────────────────────────────────────────────────────

local StageName      = "Desert Temple"
local Difficult      = "Easy"
local SkillCooldown  = 4  -- seconds between skill fires (adjustable via slider)
local AnchorDelay    = 0.5 -- delay before anchoring character


_G.IsHc        = false
_G.AutoRoom    = false
_G.AutoRejoin  = false
