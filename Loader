--[[
    checkConditions(rule, level, coins, owned, currentMode)
    ─────────────────────────────────────────────────────────
    คืน:
        "ok"      — เงื่อนไขครบ ซื้อได้เลย
        "skip"    — ไม่ต้องซื้อ (OneTimeOnly / BuyLimit เต็ม / SkipIfMode / OnlyIfMode ไม่ตรง)
        "wait"    — ยังไม่ถึงเงื่อนไข Level หรือ RequireTower (ต้องรอนานกว่า)
        "farm"    — Coins ยังไม่พอ (farm เงินแล้วกลับมาซื้อได้)
]]
local function checkConditions(rule, level, coins, owned, currentMode)
    local c = rule.Conditions or {}
    local tower = rule.Tower or ""

    -- OneTimeOnly / BuyLimit
    local buyCount = BuyHistory[tower] or 0
    if c.OneTimeOnly and buyCount >= 1 then return "skip" end
    local limit = c.BuyLimit or 0
    if limit > 0 and buyCount >= limit then return "skip" end

    -- SkipIfMode
    if c.SkipIfMode and #c.SkipIfMode > 0 and currentMode then
        for _, m in ipairs(c.SkipIfMode) do
            if m == currentMode then return "skip" end
        end
    end

    -- OnlyIfMode
    if c.OnlyIfMode and #c.OnlyIfMode > 0 and currentMode then
        local match = false
        for _, m in ipairs(c.OnlyIfMode) do
            if m == currentMode then match = true; break end
        end
        if not match then return "skip" end
    end

    -- MaxLevel
    if c.MaxLevel and level > c.MaxLevel then return "skip" end

    -- MinLevel (ต้องรอ — farm เงินไม่ช่วย)
    if c.MinLevel and level < c.MinLevel then return "wait" end

    -- RequireTower (ต้องรอให้ซื้อตัวอื่นก่อน)
    if c.RequireTower and #c.RequireTower > 0 then
        for _, req in ipairs(c.RequireTower) do
            if not owned[req] then return "wait" end
        end
    end

    -- MaxCoins
    if c.MaxCoins and coins > c.MaxCoins then return "skip" end

    -- MinCoins (farm เงินแล้วกลับมาได้)
    if c.MinCoins and coins < c.MinCoins then return "farm" end

    return "ok"
end

--[[
    getPendingBuys(currentMode)
    ────────────────────────────
    คืน list ของ rule ที่ยังต้องซื้อ แบ่งเป็น:
        canBuyNow  = { rule, ... }   ซื้อได้ทันที
        needFarm   = { rule, ... }   ต้องการเงินเพิ่ม
        waiting    = { rule, ... }   รอ Level / RequireTower (ยังทำอะไรไม่ได้)
        allDone    = true/false      ไม่มีอะไรเหลือแล้ว
]]
local function getPendingBuys(currentMode)
    if not BuyConfig then return {canBuyNow={},needFarm={},waiting={}}, true end

    local level, coins = getPlayerStats()
    local owned        = getOwnedTowers()
    local canBuyNow, needFarm, waiting = {}, {}, {}

    for _, rule in ipairs(BuyConfig) do
        local tower = rule.Tower or ""
        if tower ~= "" and not owned[tower] then
            local status = checkConditions(rule, level, coins, owned, currentMode)
            if status == "ok"   then table.insert(canBuyNow, rule)
            elseif status == "farm" then table.insert(needFarm,   rule)
            elseif status == "wait" then table.insert(waiting,    rule)
            -- "skip" → ไม่ใส่ไหนเลย
            end
        end
    end

    local allDone = (#canBuyNow == 0 and #needFarm == 0 and #waiting == 0)
    return {canBuyNow=canBuyNow, needFarm=needFarm, waiting=waiting}, allDone
end

-- คำนวณว่าต้องการเงินเพิ่มอีกเท่าไหร่รวมกัน
local function totalCoinsNeeded(farmList)
    local level, coins = getPlayerStats()
    local owned        = getOwnedTowers()
    local total = 0
    for _, rule in ipairs(farmList) do
        local need = (rule.Conditions and rule.Conditions.MinCoins) or 0
        if need > coins then total = total + (need - coins) end
    end
    return total
end

-- // ==================== SMART BUY LOOP ====================

local POLL_INTERVAL = Config.FarmPollInterval or 30  -- วินาที

local function hop()
    log("Hopping...")
    pcall(function() TeleportService:Teleport(3260590327) end)
    task.wait(5)
end

--[[
    smartBuyLoop(currentMode)
    ──────────────────────────
    Phase 1: ซื้อทุกอย่างที่ซื้อได้ตอนนี้
    Phase 2: ถ้ายังมีที่ต้องซื้อแต่เงินไม่พอ
               → ลง Mode ปกติเพื่อ farm
               → poll เงินทุก POLL_INTERVAL วินาที
               → พอเงินพอ → hop กลับ lobby → ซื้อ → loop ใหม่
    Phase 3: ไม่มีอะไรเหลือแล้ว (allDone) → return เพื่อลง strat
]]
local function smartBuyLoop(currentMode)
    if not BuyConfig then
        log("No buy_config — skipping smart-buy.")
        return
    end

    log("=== Smart Buy Loop START ===")

    while true do
        local pending, allDone = getPendingBuys(currentMode)

        -- ซื้อทุกอย่างที่ซื้อได้ทันที
        if #pending.canBuyNow > 0 then
            for _, rule in ipairs(pending.canBuyNow) do
                buyTower(rule.Tower)
            end
            -- รีเช็คหลังซื้อ (อาจปลด dependency ของตัวอื่น)
            continue
        end

        -- ไม่มีอะไรเหลือแล้ว
        if allDone then
            log("=== Smart Buy Loop DONE — all towers acquired ===")
            return
        end

        -- มีแต่ waiting (Level / RequireTower) → ไม่มีอะไรทำได้ตอนนี้ → ออกไปลง strat
        if #pending.needFarm == 0 and #pending.waiting > 0 then
            log("Remaining towers need higher Level or prerequisite towers.")
            log("Proceeding to strat — will re-check next session.")
            return
        end

        -- มี needFarm → farm เงิน
        if #pending.needFarm > 0 then
            local needed = totalCoinsNeeded(pending.needFarm)
            local _, coins = getPlayerStats()
            log(string.format(
                "Need %d more coins for %d tower(s). Starting farm (Mode: %s)...",
                needed, #pending.needFarm, currentMode
            ))

            -- เริ่ม matchmaking farm (ใช้ Mode เดิม)
            local RemoteFunc = ReplicatedStorage:WaitForChild("RemoteFunction")
            local payload = {difficulty = currentMode, mode = "survival", count = 1}
            if currentMode == "Hardcore" then payload = {mode="hardcore", difficulty="Easy", count=1}
            elseif currentMode == "Voidcore" then payload = {mode="hardcore", difficulty="Hard", count=1} end

            pcall(function() RemoteFunc:InvokeServer("Multiplayer", "v2:start", payload) end)

            -- Poll เงินทุก POLL_INTERVAL วินาที
            local farmStart = os.clock()
            while true do
                task.wait(POLL_INTERVAL)
                local _, currentCoins = getPlayerStats()
                log(string.format("[Farm] Coins: %d / need %d more", currentCoins, needed))

                -- เช็คใหม่ว่าเงินพอหรือยัง
                local newPending, newDone = getPendingBuys(currentMode)
                if newDone or #newPending.canBuyNow > 0 then
                    log("Coins ready! Hopping back to lobby to buy...")
                    hop()
                    -- รอ lobby โหลด
                    local pg = LocalPlayer:FindFirstChild("PlayerGui")
                    if pg then
                        local t = os.clock()
                        repeat task.wait(1) until pg:FindFirstChild("ReactLobbyHud") or (os.clock()-t > 30)
                    end
                    task.wait(2)
                    break  -- ออกจาก farm loop → วนซื้อใหม่
                end

                -- Safety: farm นานเกิน 20 นาที hop ใหม่
                if os.clock() - farmStart > 1200 then
                    log("[Farm] Timeout — re-queueing...")
                    pcall(function() RemoteFunc:InvokeServer("Multiplayer", "v2:start", payload) end)
                    farmStart = os.clock()
                end
            end
        end
    end
end

