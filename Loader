    if mf then return mf.Name end
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("SurfaceGui") and d.Name == "MapDisplay" then
            local t = d:FindFirstChild("Title")
            if t and t.Text ~= "" then return t.Text end
        end
    end
