if GameState == "LOBBY" then
    startMatchmaking()
    autoReady()

    -- ChildAdded จะยิงหลายครั้ง — isRunning กัน re-entry ทั้งหมด
    pg.ChildAdded:Connect(function(child)
        if child.Name == "ReactGameIntermission" or child.Name == "ReactUniversalHotbar" then
            task.wait(1)
            task.spawn(validateAndRun)  -- spawn เพื่อไม่บล็อก event thread
        end
    end)

elseif GameState == "GAME" then
    -- อยู่ในเกมอยู่แล้ว → รันตรง
    local url = findInShared(getCurrentMap(), getCurrentMode())
    if url then
        isRunning = true
        runStrat(url)
    else
        -- ไม่มี strat → veto แล้วรอรอบใหม่
        log("No strat in-game. Vetoing...")
        pcall(function() ReplicatedStorage.RemoteEvent:FireServer("LobbyVoting","Veto") end)
        task.wait(6)
        local newUrl = findInShared(getCurrentMap(), getCurrentMode())
        if newUrl then
            isRunning = true
            runStrat(newUrl)
        else
            log("Still no strat — restarting v2:start...")
            local ok = pcall(function()
                ReplicatedStorage:WaitForChild("RemoteFunction")
                    :InvokeServer("Multiplayer","v2:start",buildPayload(Config.Mode))
            end)
            if not ok then hop() end
        end
    end

else
    -- UNKNOWN state → รอ GUI
    pg.ChildAdded:Connect(function(child)
        if child.Name == "ReactGameIntermission" or child.Name == "ReactUniversalHotbar" then
            task.wait(1)
            task.spawn(validateAndRun)
        end
    end)
end

log("Initialized")
