end

local function FindMode(mapData, detected)
    if not mapData or not mapData.Modes then return nil, nil end
    detected = tostring(detected or "Easy")
    
    for name, data in pairs(mapData.Modes) do
        if name == detected then return name, data end
    end
    local low = detected:lower()
    for name, data in pairs(mapData.Modes) do
        if name:lower() == low then return name, data end
    end
    for name, data in pairs(mapData.Modes) do
        if detected:find(name) or name:find(detected) then return name, data end
    end
    
    local firstName, firstData = next(mapData.Modes)
    if firstName then
        Logger:Log("Mode '" .. detected .. "' not found, using: " .. firstName)
        return firstName, firstData
    end
    return nil, nil
end

-- // Execute Strategy (ไม่ยุ่ง Loadout!)
local function ExecuteStrat(mapKey, modeName, modeData)
    if HasExecuted then return end
    HasExecuted = true
    
    Logger:Log("=================================")
    Logger:Log("Map Detected: " .. tostring(mapKey))
    Logger:Log("Mode: " .. tostring(modeName))
    Logger:Log("URL: " .. tostring(modeData.URL))
    Logger:Log("=================================")
    
    local url = modeData.URL
    if not url or url == "" then
        warn("[ADS Loader] No strategy URL!"); return
    end
    
    Logger:Log("Fetching strategy...")
    local content = HttpGetSafe(url)
    if not content then
        warn("[ADS Loader] Failed to load strategy!"); return
    end
    
    Logger:Log("Executing...")
    local func, err = loadstring(content)
    if func then
        local ok, res = pcall(func)
        if ok then
            Logger:Log("Strategy executed successfully!")
        else
            warn("[ADS Loader] Runtime error: " .. tostring(res))
        end
    else
        warn("[ADS Loader] Syntax error: " .. tostring(err))
    end
end

-- // Auto Ready
local function AutoReady()
    if not Config.Main.AutoReady then return end
    task.spawn(function()
        Logger:Log("AutoReady waiting...")
        local reps = ReplicatedStorage:WaitForChild("StateReplicators")
        local vote = reps:WaitForChild("VoteReplicator")
        repeat task.wait(0.5)
        until vote:GetAttribute("Enabled") == true and vote:GetAttribute("Title") == "Ready?"
        pcall(function()
            ReplicatedStorage:WaitForChild("RemoteFunction"):InvokeServer("Voting", "Skip")
        end)
        Logger:Log("AutoReady sent!")
    end)
end

-- // Main Detect & Execute
local function DetectAndExecute()
    local dMap, dMode = DetectMapAndMode()
    Logger:Log("Detect -> Map: " .. tostring(dMap) .. " | Mode: " .. tostring(dMode))
    
    local mk, md = FindMap(dMap)
    if mk then
        local modeN, modeD = FindMode(md, dMode)
        if modeD then
            ExecuteStrat(mk, modeN, modeD)
        else
            Logger:Log("Mode config missing: " .. tostring(dMode))
        end
    else
        Logger:Log("Map not in database: " .. tostring(dMap))
    end
end

