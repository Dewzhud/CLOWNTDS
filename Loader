-- // ==================== SCANNER ====================

local SharedDB = {}

local function extractFromCode(code, url)
    if not code or type(code) ~= "string" then return false end

    local mode
    for _, p in ipairs({
        'TDS%s*[:%.]%s*Mode%s*%(%s*["\']([^"\']+)["\']%s*%)',
        'TDS%["Mode"%]%s*%(%s*["\']([^"\']+)["\']%s*%)',
        'TDS%[\'Mode\'%]%s*%(%s*["\']([^"\']+)["\']%s*%)',
        'Mode%s*=%s*["\']([^"\']+)["\']',
    }) do
        mode = code:match(p)
        if mode then break end
    end

    local map
    for _, p in ipairs({
        'TDS%s*[:%.]%s*GameInfo%s*%(%s*["\']([^"\']+)["\']%s*,',
        'TDS%["GameInfo"%]%s*%(%s*["\']([^"\']+)["\']%s*,',
        'TDS%[\'GameInfo\'%]%s*%(%s*["\']([^"\']+)["\']%s*,',
        'GameInfo%s*%(%s*["\']([^"\']+)["\']%s*,',
    }) do
        map = code:match(p)
        if map then break end
    end

    if not map then
        for _, p in ipairs({
            'Map%s*=%s*["\']([^"\']+)["\']',
            'map%s*=%s*["\']([^"\']+)["\']',
            '["\']?map["\']?%s*:%s*["\']([^"\']+)["\']',
        }) do
            map = code:match(p)
            if map then break end
        end
    end

    if map and mode then
        map  = map:gsub("^%s+", ""):gsub("%s+$", "")
        mode = mode:gsub("^%s+", ""):gsub("%s+$", "")
        if not SharedDB[map] then SharedDB[map] = {} end
        SharedDB[map][mode] = url
        log("Registered: " .. map .. " [" .. mode .. "] -> " .. url:match("([^/]+)$"))
        return true
    end
    return false
end

-- fix URL ไม่ใช้ gsub chain ยาว
local function fixURL(u)
    u = u:gsub("//", "/")      -- ลบ double slash ทั้งหมดก่อน
    u = u:gsub(":/", "://")    -- คืน :// กลับมา
    return u
end

local function fetchGitHubContents(repo, path, branch, baseURL)
    local items = {}
    local apiURL = "https://api.github.com/repos/" .. repo .. "/contents/" .. (path or "") .. "?ref=" .. (branch or "main")

    local ok, res = pcall(function() return game:HttpGet(apiURL) end)
    if not ok or not res then return items end

    -- แยก decode ออกมาคนละบรรทัด ไม่ใช้ ; inline
    local data
    local decodeOk
    decodeOk, data = pcall(function() return HttpService:JSONDecode(res) end)
    if not decodeOk or type(data) ~= "table" then return items end

    for _, item in ipairs(data) do
        if item.type == "file" and item.name:match("%.lua$") then
            -- fix line 66: แยก gsub ออกมาไม่ chain บนบรรทัดเดียว
            local u = baseURL .. (path and (path .. "/") or "") .. item.name
            u = fixURL(u)
            table.insert(items, u)
        elseif item.type == "dir" then
            local sub = (path and (path .. "/") or "") .. item.name
            local subItems = fetchGitHubContents(repo, sub, branch, baseURL)
            for _, su in ipairs(subItems) do
                table.insert(items, su)
            end
        end
    end
    return items
end

local function scanFiles()
    local baseURL = Config.BaseURL or ""
    if baseURL == "" and Config.Repo then
        baseURL = "https://raw.githubusercontent.com/" .. Config.Repo .. "/" .. (Config.Branch or "main") .. "/"
        if Config.Path and Config.Path ~= "" then
            baseURL = baseURL .. Config.Path .. "/"
        end
    end
    if baseURL == "" then warn("[ADS] No BaseURL or Repo!"); return false end
    if baseURL:sub(-1) ~= "/" then baseURL = baseURL .. "/" end
    log("Scanning: " .. baseURL)

    local fileURLs = {}
    if Config.Repo then
        -- fix line 89: แยกให้ชัด ไม่ยุบบรรทัด
        local branch = Config.Branch or "main"
        local path   = Config.Path or ""
        fileURLs = fetchGitHubContents(Config.Repo, path, branch, baseURL)
        log("Found " .. #fileURLs .. " .lua files")
    end

    if #fileURLs == 0 then warn("[ADS] No files found!"); return false end

    for _, fileURL in ipairs(fileURLs) do
        local code = nil
        for i = 1, 3 do
            local ok, res = pcall(function() return game:HttpGet(fileURL) end)
            if ok and type(res) == "string" and #res > 50 then
                code = res
                break
            end
            task.wait(1)
        end
        if code then extractFromCode(code, fileURL) end
    end
    return true
end

-- // ==================== GAME HELPERS ====================

local MatchmakingMap = {
    PizzaParty        = "halloween",
    Badlands          = "badlands",
    PollutedWasteland = "polluted",
    DuckyEasy         = "ducky2025",
    DuckyHard         = "ducky2025",
}

local function buildPayload(mode)
    if mode == "Hardcore" then
        return {mode = "hardcore", difficulty = "Easy", count = 1}
    elseif mode == "Voidcore" then
        return {mode = "hardcore", difficulty = "Hard", count = 1}
    elseif MatchmakingMap[mode] then
        local p = {mode = MatchmakingMap[mode], count = 1}
        if mode:match("Ducky") then p.difficulty = mode:gsub("Ducky", "") end
        return p
    else
        return {difficulty = mode, mode = "survival", count = 1}
    end
end

local function hop()
    log("Hopping...")
    pcall(function() TeleportService:Teleport(3260590327) end)
    task.wait(5)
end

local function getCurrentMap()
    local state = ReplicatedStorage:FindFirstChild("State")
    if state then
        local m = state:FindFirstChild("Map")
        if m then
            local ok, v = pcall(function() return m.Value end)
            if ok and v ~= "" then return v end
        end
    end
    local mf = workspace:FindFirstChild("Map")
    if mf then return mf.Name end
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("SurfaceGui") and d.Name == "MapDisplay" then
            local t = d:FindFirstChild("Title")
            if t and t.Text ~= "" then return t.Text end
        end
    end
    return nil
end

local function getCurrentMode()
    local state = ReplicatedStorage:FindFirstChild("State")
    if state then
        local d = state:FindFirstChild("Difficulty")
        if d then
            local ok, v = pcall(function() return d.Value end)
            if ok then return v end
        end
        local m = state:FindFirstChild("Mode")
        if m then
            local ok, v = pcall(function() return m.Value end)
            if ok then return v end
        end
    end
    return nil
end

local function findInShared(mapName, modeName)
    if not mapName then return nil end
    local modes = SharedDB[mapName]
    if not modes then
        local low = mapName:lower()
        for k, v in pairs(SharedDB) do
            if k:lower() == low then modes = v; break end
            if mapName:find(k) or k:find(mapName) then modes = v; break end
            if mapName:gsub("%s+", ""):lower() == k:gsub("%s+", ""):lower() then modes = v; break end
        end
    end
    if not modes then return nil end
    modeName = modeName or Config.Mode
    local url = modes[modeName]
    if not url then
        local lm = modeName:lower()
        for k, v in pairs(modes) do
            if k:lower() == lm then url = v; break end
        end
    end
    if not url then
        local fm, fu = next(modes)
        if fu then
            log("Mode '" .. modeName .. "' not found, using: " .. fm)
            url = fu
        end
    end
    return url
end

local function runStrat(url)
    if not url then return false end
    log("Executing: " .. url)
    local ok, err = pcall(function()
        loadstring(game:HttpGet(url))()
    end)
    if ok then
        log("Strat running!")
        return true
    end
    log("runStrat failed: " .. tostring(err))
    return false
end

local function autoReady()
    task.spawn(function()
        local reps = ReplicatedStorage:WaitForChild("StateReplicators")
        local vote = reps:WaitForChild("VoteReplicator")
        repeat task.wait(0.5)
        until vote:GetAttribute("Enabled") == true and vote:GetAttribute("Title") == "Ready?"
        pcall(function()
            ReplicatedStorage:WaitForChild("RemoteFunction"):InvokeServer("Voting", "Skip")
        end)
        log("Ready sent")
    end)
end

local function startMatchmaking()
    log("Matchmaking: " .. Config.Mode)
    local RemoteFunc = ReplicatedStorage:WaitForChild("RemoteFunction")
    local payload = buildPayload(Config.Mode)
    repeat
        local ok, res = pcall(function()
            return RemoteFunc:InvokeServer("Multiplayer", "v2:start", payload)
        end)
        if ok and (res == true or (type(res) == "table" and res.Success == true) or (type(res) == "userdata")) then
            log("Matchmaking OK")
            break
        end
        task.wait(0.5)
    until false
end

-- // ==================== VALIDATE AND RUN ====================

local isRunning = false

local function validateAndRun()
    if isRunning then
        log("Already running — ignoring trigger.")
        return
    end
    isRunning = true

    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then
        isRunning = false
        hop()
        return
    end

    log("Waiting for intermission...")
    local startT = os.clock()
    repeat
        if pg:FindFirstChild("ReactGameIntermission") then break end
        if pg:FindFirstChild("ReactUniversalHotbar") then break end
        task.wait(0.5)
    until (os.clock() - startT > 60)

    -- อยู่ในเกมแล้ว
    if pg:FindFirstChild("ReactUniversalHotbar") then
        local url = findInShared(getCurrentMap(), getCurrentMode())
        if url then
            runStrat(url)
        else
            log("In-game but no strat found.")
            isRunning = false
        end
        return
    end

    -- ── intermission loop ──
    local lastSeenMap  = nil
    local lastVetoTime = 0
    local vetoCount    = 0
    local loopStart    = os.clock()

    while true do
        task.wait(1)

        local mapName  = getCurrentMap()
        local modeName = getCurrentMode()
        log("Check -> " .. tostring(mapName) .. " | " .. tostring(modeName))

        -- เจอแมพที่มีใน DB
        local url = findInShared(mapName, modeName)
        if url then
            log("Match found! Waiting for game to start...")
            repeat task.wait(0.5) until pg:FindFirstChild("ReactUniversalHotbar")
            task.wait(0.5)
            runStrat(url)
            return  -- หยุด loop ทันที
        end

        -- แมพยังไม่โหลด
        if not mapName then
            task.wait(1)
            -- ใช้ goto แทน continue เพื่อ compatibility
            goto loopEnd
        end

        -- ── Veto Fallback ──
        if mapName == lastSeenMap then
            local waited = os.clock() - lastVetoTime
            if waited < 5 then
                log(string.format("Same map '%s' — waiting %.1fs...", mapName, 5 - waited))
                task.wait(5 - waited)
                goto loopEnd
            end
            -- ครบ 5 วิแล้วยังเดิม → re-queue
            log("Same map after 5s — re-queueing v2:start...")
            local ok = pcall(function()
                ReplicatedStorage:WaitForChild("RemoteFunction")
                    :InvokeServer("Multiplayer", "v2:start", buildPayload(Config.Mode))
            end)
            if ok then
                log("v2:start sent.")
                lastSeenMap  = nil
                lastVetoTime = 0
                vetoCount    = 0
            else
                log("v2:start failed — hopping...")
                isRunning = false
                hop()
                return
            end
        else
            -- แมพใหม่ ไม่มีใน DB → veto
            log(string.format("No strat for '%s' — vetoing...", mapName))
            pcall(function()
                ReplicatedStorage.RemoteEvent:FireServer("LobbyVoting", "Veto")
            end)
            lastSeenMap  = mapName
            lastVetoTime = os.clock()
            vetoCount    = vetoCount + 1

            if vetoCount > 3 then
                log("Too many vetoes — re-queueing...")
                local ok = pcall(function()
                    ReplicatedStorage:WaitForChild("RemoteFunction")
                        :InvokeServer("Multiplayer", "v2:start", buildPayload(Config.Mode))
                end)
                if ok then
                    log("v2:start sent.")
                    vetoCount   = 0
                    lastSeenMap = nil
                else
                    log("v2:start failed — hopping...")
                    isRunning = false
                    hop()
                    return
                end
            end
        end

        -- Global timeout
        if os.clock() - loopStart > 120 then
            log("Timeout — hopping...")
            isRunning = false
            hop()
            return
        end

        ::loopEnd::
    end
end

