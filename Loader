-- // ==================== BASE URL BUILDER ====================

local function buildBaseURL()
    local base = Config.BaseURL
    if base and base ~= "" then
        if base:sub(-1) ~= "/" then base = base .. "/" end
        return base
    end
    if Config.Repo then
        local branch = Config.Branch or "main"
        local path = Config.Path or ""
        if path ~= "" and path:sub(-1) ~= "/" then path = path .. "/" end
        return "https://raw.githubusercontent.com/" .. Config.Repo .. "/" .. branch .. "/" .. path
    end
    return nil
end

-- // ==================== FETCH ====================

local FileCache = {}
local ValidFiles = {} -- ไฟล์ที่เจอว่ามีจริง

local function fetchFile(url, retries)
    retries = retries or 2
    if FileCache[url] ~= nil then return FileCache[url] end
    
    for i = 1, retries do
        local ok, res = pcall(function() return game:HttpGet(url, true) end)
        if ok and type(res) == "string" then
            if res:match("^404") or res:match("Not Found") or res:match('"message"') or #res < 20 then
                FileCache[url] = false
                return false
            end
            FileCache[url] = res
            return res
        end
        task.wait(0.5)
    end
    FileCache[url] = false
    return false
end

-- // ==================== EXTRACTOR ====================

local SharedDB = {}

function extractFromCode(code, url)
    if not code or type(code) ~= "string" or #code < 50 then return false end
    
    local mode = nil
    for _, p in ipairs({
        'TDS%s*:%s*Mode%s*%(%s*["\']([^"\']+)["\']%s*%)',
        'TDS%["Mode"%]%s*%(%s*["\']([^"\']+)["\']%s*%)',
        'TDS%.Mode%s*%(%s*["\']([^"\']+)["\']%s*%)',
        'Mode%s*%(%s*["\']([^"\']+)["\']%s*%)',
    }) do
        mode = code:match(p)
        if mode then break end
    end
    
    local map = nil
    for _, p in ipairs({
        'TDS%s*:%s*GameInfo%s*%(%s*["\']([^"\']+)["\']%s*,',
        'TDS%["GameInfo"%]%s*%(%s*["\']([^"\']+)["\']%s*,',
        'TDS%.GameInfo%s*%(%s*["\']([^"\']+)["\']%s*,',
        'GameInfo%s*%(%s*["\']([^"\']+)["\']%s*,',
    }) do
        map = code:match(p)
        if map then break end
    end
    
    if map and mode then
        map = map:gsub("^%s+", ""):gsub("%s+$", "")
        mode = mode:gsub("^%s+", ""):gsub("%s+$", "")
        if not SharedDB[map] then SharedDB[map] = {} end
        SharedDB[map][mode] = url
        log("Registered: " .. map .. " [" .. mode .. "] <- " .. (url:match("([^/]+)$") or url))
        return true
    end
    return false
end

-- // ==================== BRUTE-FORCE FILE GENERATOR ====================

local function generateFileList()
    local files = {}
    local added = {}
    
    local function add(name)
        if not name then return end
        name = tostring(name)
        if not name:match("%.lua$") then name = name .. ".lua" end
        if not added[name] then
            added[name] = true
            table.insert(files, name)
        end
    end
    
    -- Maps ทั้งหมดใน TDS
    local maps = {
        "GrassIsGreener", "Farm", "Crossroads", "DesertedVillage",
        "TropicalIsles", "WinterStronghold", "FungiForest", "CandyValley",
        "CrystalCave", "SummerCastle", "AutumnFalling", "WinterAbyss",
        "MidnightIssue", "AbyssalTrench", "LostValley", "Badlands",
        "PollutedWasteland", "Polluted", "PizzaParty", "DuckyRevenge",
        "Ducky", "BlackSpot", "BurrowBrawl", "CandyValley2"
    }
    
    -- Modes ทั้งหมด
    local modes = {
        "Easy", "Hard", "Insane", "Fallen", "Hardcore", "Voidcore",
        "Molten", "Golden", "Nuclear", "Tutorial"
    }
    
    -- ชื่อย่อ Map
    local shortMaps = {
        GI = "GrassIsGreener", FM = "Farm", CR = "Crossroads",
        DV = "DesertedVillage", TI = "TropicalIsles", WS = "WinterStronghold",
        FF = "FungiForest", CV = "CandyValley", CC = "CrystalCave",
        SC = "SummerCastle", AF = "AutumnFalling", WA = "WinterAbyss",
        MI = "MidnightIssue", AT = "AbyssalTrench", LV = "LostValley",
        BL = "Badlands", PW = "PollutedWasteland", PP = "PizzaParty",
        DR = "DuckyRevenge", BS = "BlackSpot", BB = "BurrowBrawl"
    }
    
    -- 1. ชื่อ Mode อย่างเดียว (เช่น Easy.lua)
    for _, m in ipairs(modes) do add(m) end
    
    -- 2. ชื่อ Map อย่างเดียว (เช่น Badlands.lua)
    for _, map in ipairs(maps) do add(map) end
    
    -- 3. Map_Mode (เช่น Badlands_Easy.lua)
    for _, map in ipairs(maps) do
        for _, mode in ipairs(modes) do
            add(map .. "_" .. mode)
            add(map .. "-" .. mode)
            add(map .. mode)
        end
    end
    
    -- 4. Mode_Map (เช่น Easy_Badlands.lua)
    for _, mode in ipairs(modes) do
        for _, map in ipairs(maps) do
            add(mode .. "_" .. map)
            add(mode .. "-" .. map)
            add(mode .. map)
        end
    end
    
    -- 5. ชื่อย่อ (เช่น BL_Easy.lua)
    for short, full in pairs(shortMaps) do
        for _, mode in ipairs(modes) do
            add(short .. "_" .. mode)
            add(short .. mode)
            add(mode .. "_" .. short)
        end
    end
    
    -- 6. Prefix ยอดนิยม
    for _, map in ipairs(maps) do
        add("Strat_" .. map)
        add("Auto_" .. map)
        add("Script_" .. map)
        add("Load_" .. map)
    end
    for _, mode in ipairs(modes) do
        add("Strat_" .. mode)
        add("Auto_" .. mode)
    end
    
    -- 7. ชื่อพิเศษ / Event
    add("Pizza")
    add("Halloween")
    add("Ducky")
    add("Summer")
    add("Winter")
    add("Autumn")
    
    -- 8. ไฟล์ทั่วไป
    add("Main")
    add("Loader")
    add("Core")
    add("Strat")
    add("Auto")
    add("TDS")
    add("Game")
    
    -- 9. ชื่อที่ user ใส่มาใน Config
    if Config.ExtraFiles then
        for _, f in ipairs(Config.ExtraFiles) do add(f) end
    end
    
    return files
end

-- // ==================== SCRAPE GITHUB TREE PAGE ====================

local function scrapeGitHubTree(repo, path, branch)
    branch = branch or "main"
    path = path or ""
    local url = "https://github.com/" .. repo .. "/tree/" .. branch .. "/" .. path
    log("Scraping: " .. url)
    
    local code = fetchFile(url, 1)
    if not code or type(code) ~= "string" then return 0 end
    
    -- GitHub tree page มี JSON data ใน <script type="application/json" data-target="react-app.embeddedData">
    local jsonData = code:match('<script[^>]*data%-target="react%-app%.embeddedData"[^>]*>(.-)</script>')
    if not jsonData then
        -- fallback: หาไฟล์ .lua จาก href
        jsonData = code
    end
    
    local count = 0
    -- Pattern หาไฟล์ .lua ใน HTML
    for filename in jsonData:gmatch('([^"/]+%.lua)"') do
        add(filename)
    end
    for filename in jsonData:gmatch('title="([^"]+%.lua)"') do
        add(filename)
    end
    -- React embedded data pattern
    for filename in jsonData:gmatch('"name":"([^"]+%.lua)"') do
        add(filename)
    end
    
    log("Scraped " .. count .. " filenames from GitHub page")
    return count
end

-- // ==================== BRUTE-FORCE SCANNER ====================

local function bruteForceScan(baseURL)
    local files = generateFileList()
    log("Brute-forcing " .. #files .. " filenames...")
    
    local found = 0
    local checked = 0
    local maxCheck = Config.MaxBruteForce or 200
    local minStrats = Config.MinStrats or 1
    local delay = Config.BruteDelay or 0.2
    
    for i, filename in ipairs(files) do
        if checked >= maxCheck then 
            log("Max brute-force limit reached (" .. maxCheck .. ")")
            break 
        end
        
        local url = baseURL .. filename
        if FileCache[url] == nil then -- ยังไม่เคยเช็ค
            checked = checked + 1
            local code = fetchFile(url, 1)
            
            if code and code ~= false then
                ValidFiles[filename] = true
                if extractFromCode(code, url) then
                    found = found + 1
                    log("HIT: " .. filename)
                    if found >= minStrats then
                        -- ถ้าเจอพอแล้ว ลองเช็คอีกนิดหน่อยเพื่อหาไฟล์อื่น
                        if found >= minStrats + 5 then break end
                    end
                else
                    log("Found but no TDS data: " .. filename)
                end
            end
            
            task.wait(delay)
        end
    end
    
    log("Brute-force: checked " .. checked .. ", found " .. found .. " strats")
    return found
end

-- // ==================== MAIN SCANNER ====================

local function scanFiles()
    local baseURL = buildBaseURL()
    if not baseURL then warn("[ADS] No BaseURL or Repo!"); return false end
    log("BaseURL: " .. baseURL)
    
    -- วิธี 1: ลอง scrape GitHub tree page (ถ้าได้จะรู้ชื่อไฟล์ทั้งหมด)
    if Config.Repo then
        scrapeGitHubTree(Config.Repo, Config.Path, Config.Branch)
    end
    
    -- วิธี 2: Brute-force ชื่อไฟล์
    local found = bruteForceScan(baseURL)
    
    -- วิธี 3: ถ้ายังไม่พอ ลอง common names อีกรอบ (กรณี brute force ไม่ครอบคลุม)
    if found == 0 then
        log("Zero found, trying extended common names...")
        local common = {"Easy", "Hard", "Insane", "Fallen", "Hardcore", "Voidcore", 
                       "PizzaParty", "Badlands", "Polluted", "DuckyEasy", "DuckyHard"}
        for _, name in ipairs(common) do
            local url = baseURL .. name .. ".lua"
            local code = fetchFile(url, 1)
            if code and extractFromCode(code, url) then found = found + 1 end
            task.wait(0.3)
        end
    end
    
    return found > 0
end

