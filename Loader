local function findInShared(mapName, modeName)
    if not mapName then return nil end

    local modes = SharedDB[mapName]
    if not modes then
        local low      = mapName:lower()
        local mapStrip = mapName:gsub("%s+", ""):lower()
        for k, v in pairs(SharedDB) do
            if k:lower() == low then
                modes = v; break
            end
            local ok1, r1 = pcall(function() return mapName:find(k, 1, true) end)
            local ok2, r2 = pcall(function() return k:find(mapName, 1, true) end)
            if (ok1 and r1) or (ok2 and r2) then
                modes = v; break
            end
            if k:gsub("%s+", ""):lower() == mapStrip then
                modes = v; break
            end
        end
    end
    if not modes then return nil end

    modeName = modeName or Config.Mode or ""

    local url = nil
    if modeName ~= "" then
        url = modes[modeName]
        if not url then
            local lm = modeName:lower()
            for k, v in pairs(modes) do
                if k:lower() == lm then url = v; break end
            end
        end
    end

    if not url then
        local fm, fu = next(modes)
        if fu then
            log("Mode '" .. tostring(modeName) .. "' not found, using: " .. tostring(fm))
            url = fu
        end
    end
    return url
end

-- // ── runStrat ── (ประกาศก่อน validateAndRun ที่เรียกมัน)
local function runStrat(url)
    if not url then return false end
    log("Executing: " .. tostring(url))

    local ok, res = pcall(function() return game:HttpGet(url) end)
    if not ok or type(res) ~= "string" or #res < 10 then
        log("HttpGet failed: " .. tostring(res))
        return false
    end

    local fn, err = _loadstring(res)
    if not fn then
        log("loadstring failed: " .. tostring(err))
        return false
    end

    local runOk, runErr = pcall(fn)
    if runOk then
        log("Strat running!")
        return true
    end
    log("Strat error: " .. tostring(runErr))
    return false
end

