local SharedDB = {}

local function extractFromCode(code, url)
    if not code or type(code) ~= "string" then return false end

    local mode
    for _, p in ipairs({
        'TDS%s*[:%.]%s*Mode%s*%(%s*["\']([^"\']+)["\']%s*%)',
        'TDS%["Mode"%]%s*%(%s*["\']([^"\']+)["\']%s*%)',
        'TDS%[\'Mode\'%]%s*%(%s*["\']([^"\']+)["\']%s*%)',
        'Mode%s*=%s*["\']([^"\']+)["\']',
    }) do
        mode = code:match(p)
        if mode then break end
    end

    local map
    for _, p in ipairs({
        'TDS%s*[:%.]%s*GameInfo%s*%(%s*["\']([^"\']+)["\']%s*,',
        'TDS%["GameInfo"%]%s*%(%s*["\']([^"\']+)["\']%s*,',
        'TDS%[\'GameInfo\'%]%s*%(%s*["\']([^"\']+)["\']%s*,',
        'GameInfo%s*%(%s*["\']([^"\']+)["\']%s*,',
    }) do
        map = code:match(p)
        if map then break end
    end

    if not map then
        for _, p in ipairs({
            'Map%s*=%s*["\']([^"\']+)["\']',
            'map%s*=%s*["\']([^"\']+)["\']',
            '["\']?map["\']?%s*:%s*["\']([^"\']+)["\']',
        }) do
            map = code:match(p)
            if map then break end
        end
    end

    if map and mode then
        map  = map:gsub("^%s+", ""):gsub("%s+$", "")
        mode = mode:gsub("^%s+", ""):gsub("%s+$", "")
        if not SharedDB[map] then SharedDB[map] = {} end
        SharedDB[map][mode] = url
        log("Registered: " .. map .. " [" .. mode .. "] -> " .. url:match("([^/]+)$"))
        return true
    end
    return false
end

local function fixURL(u)
    u = u:gsub("//", "/")
    u = u:gsub(":/", "://")
    return u
end

local function fetchGitHubContents(repo, path, branch, baseURL)
    local items = {}
    local apiURL = "https://api.github.com/repos/" .. repo .. "/contents/"
        .. (path or "") .. "?ref=" .. (branch or "main")

    local ok, res = pcall(function() return game:HttpGet(apiURL) end)
    if not ok or not res then return items end

    local decodeOk, data
    decodeOk, data = pcall(function() return HttpService:JSONDecode(res) end)
    if not decodeOk or type(data) ~= "table" then return items end

    for _, item in ipairs(data) do
        if item.type == "file" and item.name:match("%.lua$") then
            local u = baseURL .. (path and (path .. "/") or "") .. item.name
            table.insert(items, fixURL(u))
        elseif item.type == "dir" then
            local sub = (path and (path .. "/") or "") .. item.name
            local subItems = fetchGitHubContents(repo, sub, branch, baseURL)
            for _, su in ipairs(subItems) do
                table.insert(items, su)
            end
        end
    end
    return items
end

local function scanFiles()
    local baseURL = Config.BaseURL or ""
    if baseURL == "" and Config.Repo ~= "" then
        baseURL = "https://raw.githubusercontent.com/" .. Config.Repo
            .. "/" .. Config.Branch .. "/"
        if Config.Path ~= "" then
            baseURL = baseURL .. Config.Path .. "/"
        end
    end
    if baseURL == "" then warn("[ADS] No BaseURL or Repo!"); return false end
    if baseURL:sub(-1) ~= "/" then baseURL = baseURL .. "/" end
    log("Scanning: " .. baseURL)

    local fileURLs = {}
    if Config.Repo ~= "" then
        fileURLs = fetchGitHubContents(Config.Repo, Config.Path, Config.Branch, baseURL)
        log("Found " .. #fileURLs .. " .lua files")
    end

    if #fileURLs == 0 then warn("[ADS] No files found!"); return false end

    for _, fileURL in ipairs(fileURLs) do
        local code = nil
        for i = 1, 3 do
            local ok2, res2 = pcall(function() return game:HttpGet(fileURL) end)
            if ok2 and type(res2) == "string" and #res2 > 50 then
                code = res2
                break
            end
            task.wait(1)
        end
        if code then extractFromCode(code, fileURL) end
    end
    return true
end

