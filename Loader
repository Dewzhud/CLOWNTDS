local function findInShared(mapName, modeName)
    if not mapName then return nil end
    local modes = SharedDB[mapName]
    if not modes then
        local low = mapName:lower()
        local mapStrip = mapName:gsub("%s+", ""):lower()
        for k, v in pairs(SharedDB) do
            local klow = k:lower()
            if klow == low then modes = v; break end
            local ok1, r1 = pcall(function() return mapName:find(k) end)
            local ok2, r2 = pcall(function() return k:find(mapName) end)
            if (ok1 and r1) or (ok2 and r2) then modes = v; break end
            if mapStrip == k:gsub("%s+", ""):lower() then modes = v; break end
        end
    end
    if not modes then return nil end
    modeName = modeName or Config.Mode or ""
    local url = nil
    if modeName ~= "" then
        url = modes[modeName]
        if not url then
            local lm = modeName:lower()
            for k, v in pairs(modes) do
                if k:lower() == lm then url = v; break end
            end
        end
    end
    if not url then
        local fm, fu = next(modes)
        if fu then
            log("Mode '" .. tostring(modeName) .. "' not found, using: " .. tostring(fm))
            url = fu
        end
    end
    return url
end

local function runStrat(url)
    if not url then return false end
