-- // Check Target
local function isTargetMap(mapName, modeName)
    if not mapName then return false end
    local entry = Config.Maps[mapName]
    if not entry then
        for k, v in pairs(Config.Maps) do
            if k:lower() == mapName:lower() then entry = v; break end
            if mapName:find(k) or k:find(mapName) then entry = v; break end
            if mapName:gsub("%s+", ""):lower() == k:gsub("%s+", ""):lower() then entry = v; break end
        end
    end
    if not entry then return false end
    if entry.Mode and modeName and entry.Mode:lower() ~= modeName:lower() then return false end
    return true, entry.URL
end

