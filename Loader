local function buildPayload(mode)
    local m = tostring(mode or "Easy")
    local low = m:lower()
    if low == "hardcore" then return {mode = "hardcore", difficulty = "Easy", count = 1}
    elseif low == "voidcore" then return {mode = "hardcore", difficulty = "Hard", count = 1}
    elseif MatchmakingMap[m] then
        local p = {mode = MatchmakingMap[m], count = 1}
        if m:match("Ducky") then p.difficulty = m:gsub("Ducky", "") end
        return p
    else
        return {difficulty = m, mode = "survival", count = 1}
    end
end

