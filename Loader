-- // Validate Map (Veto / Hop)
local function validateAndRun()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return end
    
    log("Waiting for intermission...")
    local startT = os.clock()
    repeat
        if pg:FindFirstChild("ReactGameIntermission") then break end
        if pg:FindFirstChild("ReactUniversalHotbar") then break end
        task.wait(0.5)
    until (os.clock() - startT > 30)
    
    task.wait(2.5)
    
    local mapName = getCurrentMap()
    local modeName = getCurrentMode()
    log("Detected: " .. tostring(mapName) .. " | " .. tostring(modeName))
    
    local isTarget, url = isTargetMap(mapName, modeName)
    
    if isTarget then
        log("Target match! ✓")
        if not pg:FindFirstChild("ReactUniversalHotbar") then
            repeat task.wait(0.5) until pg:FindFirstChild("ReactUniversalHotbar")
        end
        task.wait(2)
        runStrat(url)
        return true
    else
        log("Not target. Trying veto...")
        if canVeto() then
            sendVeto()
            task.wait(5)
            local newMap = getCurrentMap()
            local newMode = getCurrentMode()
            local isNewTarget, newUrl = isTargetMap(newMap, newMode)
            if isNewTarget then
                log("Veto success!")
                if not pg:FindFirstChild("ReactUniversalHotbar") then
                    repeat task.wait(0.5) until pg:FindFirstChild("ReactUniversalHotbar")
                end
                task.wait(2)
                runStrat(newUrl)
                return true
            end
        end
        log("Veto failed. Hopping...")
        hop()
        return false
    end
end

