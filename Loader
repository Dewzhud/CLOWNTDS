-- // ==================== ADS MINIMAL LOADER (Veto → Hop) ==================== //
-- Config: getgenv().ADS_Config = { Mode = "Easy", Maps = { ["Map"] = {Mode="...", URL="..."} } }

local Config = getgenv().ADS_Config
if not Config then warn("[ADS] Config missing!"); return end
if not Config.Mode then warn("[ADS] Config.Mode missing!"); return end
if not Config.Maps then warn("[ADS] Config.Maps missing!"); return end

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")
local LocalPlayer = Players.LocalPlayer or Players.PlayerAdded:Wait()

local function log(msg) print("[ADS] " .. tostring(msg)) end

-- // Game State
local GameState = "UNKNOWN"
local pg = LocalPlayer:FindFirstChild("PlayerGui")
if pg then
    if pg:FindFirstChild("ReactLobbyHud") then GameState = "LOBBY"
    elseif pg:FindFirstChild("ReactUniversalHotbar") then GameState = "GAME" end
end

-- // HttpGet
local function get(url)
    for i = 1, 10 do
        local ok, res = pcall(function() return game:HttpGet(url) end)
        if ok and type(res) == "string" and #res > 50 then return res end
        task.wait(1)
    end
    return nil
end

-- // Payload Builder
local MatchmakingMap = {
    PizzaParty = "halloween",
    Badlands = "badlands",
    PollutedWasteland = "polluted",
    DuckyEasy = "ducky2025",
    DuckyHard = "ducky2025"
}

local function buildPayload(mode)
    if mode == "Hardcore" then return {mode = "hardcore", difficulty = "Easy", count = 1}
    elseif mode == "Voidcore" then return {mode = "hardcore", difficulty = "Hard", count = 1}
    elseif MatchmakingMap[mode] then
        local p = {mode = MatchmakingMap[mode], count = 1}
        if mode:match("Ducky") then p.difficulty = mode:gsub("Ducky", "") end
        return p
    else
        return {difficulty = mode, mode = "survival", count = 1}
    end
end

-- // Hop
local function hop()
    log("Hopping...")
    pcall(function() TeleportService:Teleport(3260590327) end)
    task.wait(5)
end

-- // Detect
local function getCurrentMap()
    local state = ReplicatedStorage:FindFirstChild("State")
    if state then
        local m = state:FindFirstChild("Map")
        if m then local ok, v = pcall(function() return m.Value end); if ok and v ~= "" then return v end end
    end
    local mf = workspace:FindFirstChild("Map")
    if mf then return mf.Name end
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("SurfaceGui") and d.Name == "MapDisplay" then
            local t = d:FindFirstChild("Title")
            if t and t.Text ~= "" then return t.Text end
        end
    end
    return nil
end

local function getCurrentMode()
    local state = ReplicatedStorage:FindFirstChild("State")
    if state then
        local d = state:FindFirstChild("Difficulty")
        if d then local ok, v = pcall(function() return d.Value end); if ok then return v end end
        local m = state:FindFirstChild("Mode")
        if m then local ok, v = pcall(function() return m.Value end); if ok then return v end end
    end
    return nil
end

-- // Find Map
local function findMapEntry(mapName)
    if not mapName then return nil, nil end
    if Config.Maps[mapName] then return Config.Maps[mapName], mapName end
    local low = mapName:lower()
    for k, v in pairs(Config.Maps) do
        if k:lower() == low then return v, k end
    end
    for k, v in pairs(Config.Maps) do
        if mapName:find(k) or k:find(mapName) then return v, k end
    end
    for k, v in pairs(Config.Maps) do
        if mapName:gsub("%s+", ""):lower() == k:gsub("%s+", ""):lower() then return v, k end
    end
    return nil, nil
end

-- // Veto
local function canVeto()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return false end
    local inter = pg:FindFirstChild("ReactGameIntermission")
    if not inter then return false end
    local frame = inter:FindFirstChild("Frame")
    if not frame then return false end
    local vetoBtn = frame:FindFirstChild("veto")
    if not vetoBtn then return false end
    local val = vetoBtn:FindFirstChild("value")
    if not val then return false end
    local txt = val.Text
    if txt:find("Veto") then
        local cur, tot = txt:match("(%d+)/(%d+)")
        if cur and tot then
            local c, t = tonumber(cur), tonumber(tot)
            if c and t and c < t then return true end
        elseif txt == "Veto" then return true end
    end
    return false
end

local function sendVeto()
    pcall(function() ReplicatedStorage:WaitForChild("RemoteEvent"):FireServer("LobbyVoting", "Veto") end)
    log("Veto sent")
end

-- // Execute Strat
local function runStrat(url)
    if not url then return end
    log("Loading strat...")
    local code = get(url)
    if not code then log("Failed to load strat"); return end
    local f, e = loadstring(code)
    if f then
        local ok, r = pcall(f)
        if ok then log("Strat running!") else log("Runtime error: " .. tostring(r)) end
    else
        log("Syntax error: " .. tostring(e))
    end
end

-- // Auto Ready
local function autoReady()
    task.spawn(function()
        local reps = ReplicatedStorage:WaitForChild("StateReplicators")
        local vote = reps:WaitForChild("VoteReplicator")
        repeat task.wait(0.5)
        until vote:GetAttribute("Enabled") == true and vote:GetAttribute("Title") == "Ready?"
        pcall(function() ReplicatedStorage:WaitForChild("RemoteFunction"):InvokeServer("Voting", "Skip") end)
        log("Ready sent")
    end)
end

-- // Matchmaking
local function startMatchmaking()
    log("Matchmaking: " .. Config.Mode)
    local RemoteFunc = ReplicatedStorage:WaitForChild("RemoteFunction")
    local payload = buildPayload(Config.Mode)
    repeat
        local success, res = pcall(function() return RemoteFunc:InvokeServer("Multiplayer", "v2:start", payload) end)
        if success and (res == true or (type(res) == "table" and res.Success == true) or (type(res) == "userdata")) then
            log("Matchmaking OK")
            break
        end
        task.wait(0.5)
    until false
end

-- // Validate: ถ้าไม่ใช่แมพที่ต้องการ → Veto 1 รอบ → ถ้ายังไม่ใช่ → Hop
local function validateAndRun()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then hop(); return end
    
    log("Waiting for intermission...")
    local startT = os.clock()
    repeat
        if pg:FindFirstChild("ReactGameIntermission") then break end
        if pg:FindFirstChild("ReactUniversalHotbar") then break end
        task.wait(0.5)
    until (os.clock() - startT > 30)
    
    task.wait(2.5)
    
    local mapName = getCurrentMap()
    local modeName = getCurrentMode()
    log("Detected: " .. tostring(mapName) .. " | " .. tostring(modeName))
    
    local entry, matchedName = findMapEntry(mapName)
    
    -- ถ้าเจอแมพที่ตรง + โหมดตรง → เข้าเกมเลย
    if entry and (not entry.Mode or not modeName or entry.Mode:lower() == modeName:lower()) then
        log("Match: " .. tostring(matchedName))
        if not pg:FindFirstChild("ReactUniversalHotbar") then
            repeat task.wait(0.5) until pg:FindFirstChild("ReactUniversalHotbar")
        end
        task.wait(2)
        runStrat(entry.URL)
        return
    end
    
    -- ไม่ใช่แมพที่ต้องการ → Veto 1 รอบ
    log("Not target. Vetoing...")
    
    if canVeto() then
        sendVeto()
        task.wait(6)
        
        local newMap = getCurrentMap()
        local newMode = getCurrentMode()
        log("After veto: " .. tostring(newMap) .. " | " .. tostring(newMode))
        
        local newEntry, newMatched = findMapEntry(newMap)
        if newEntry and (not newEntry.Mode or not newMode or newEntry.Mode:lower() == newMode:lower()) then
            log("Veto success: " .. tostring(newMatched))
            if not pg:FindFirstChild("ReactUniversalHotbar") then
                repeat task.wait(0.5) until pg:FindFirstChild("ReactUniversalHotbar")
            end
            task.wait(2)
            runStrat(newEntry.URL)
            return
        end
        
        log("Veto failed.")
    else
        log("Cannot veto.")
    end
    
    -- ไม่สำเร็จ → Hop
    hop()
end

-- // MAIN
log("State: " .. GameState)

if GameState == "LOBBY" then
    startMatchmaking()
    autoReady()
    
    pg.ChildAdded:Connect(function(child)
        if child.Name == "ReactGameIntermission" or child.Name == "ReactUniversalHotbar" then
            task.wait(1)
            validateAndRun()
        end
    end)

elseif GameState == "GAME" then
    -- ถ้ารันในเกมอยู่แล้ว ก็ตรวจสอบเหมือนกัน
    local mapName = getCurrentMap()
    local modeName = getCurrentMode()
    local entry, matched = findMapEntry(mapName)
    
    if entry and (not entry.Mode or not modeName or entry.Mode:lower() == modeName:lower()) then
        runStrat(entry.URL)
    else
        -- ไม่ใช่แมพเป้าหมาย → ลอง Veto ถ้าได้ ถ้าไม่ได้ก็ Hop
        log("Not target map.")
        if canVeto() then
            sendVeto()
            task.wait(6)
            local newMap = getCurrentMap()
            local newEntry, _ = findMapEntry(newMap)
            if newEntry then
                runStrat(newEntry.URL)
                return
            end
        end
        hop()
    end

else
    pg.ChildAdded:Connect(function(child)
        if child.Name == "ReactGameIntermission" or child.Name == "ReactUniversalHotbar" then
            task.wait(1)
            validateAndRun()
        end
    end)
end

log("Initialized")    end
    return false
end

