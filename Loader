local function autoReady()
    task.spawn(function()
        local ok, reps = pcall(function()
            return ReplicatedStorage:WaitForChild("StateReplicators", 30)
        end)
        if not ok or not reps then return end
        local ok2, vote = pcall(function()
            return reps:WaitForChild("VoteReplicator", 30)
        end)
        if not ok2 or not vote then return end
        repeat task.wait(0.5)
        until vote:GetAttribute("Enabled") == true
            and vote:GetAttribute("Title") == "Ready?"
        pcall(function()
            ReplicatedStorage:WaitForChild("RemoteFunction", 10)
                :InvokeServer("Voting", "Skip")
        end)
        log("Ready sent")
    end)
end

local function startMatchmaking()
    log("Matchmaking: " .. Config.Mode)
    local ok, RemoteFunc = pcall(function()
        return ReplicatedStorage:WaitForChild("RemoteFunction", 30)
    end)
    if not ok or not RemoteFunc then
        warn("[ADS] RemoteFunction not found!")
        return
    end
    local payload = buildPayload(Config.Mode)
    repeat
        local callOk, res = pcall(function()
            return RemoteFunc:InvokeServer("Multiplayer", "v2:start", payload)
        end)
        if callOk and (
            res == true
            or (type(res) == "table" and res.Success == true)
            or (type(res) == "userdata")
        ) then
            log("Matchmaking OK")
            break
        end
        task.wait(0.5)
    until false
end

-- // ==================== VALIDATE AND RUN ====================

local isRunning = false

local function validateAndRun()
    if isRunning then
        log("Already running — ignoring.")
        return
    end
    isRunning = true

    local pg = LocalPlayer:FindFirstChild("PlayerGui")
        or LocalPlayer:WaitForChild("PlayerGui", 30)
    if not pg then
        isRunning = false
        hop()
        return
    end

    log("Waiting for intermission...")
    local startT = os.clock()
    repeat
        if pg:FindFirstChild("ReactGameIntermission") then break end
        if pg:FindFirstChild("ReactUniversalHotbar") then break end
        task.wait(0.5)
    until os.clock() - startT > 60

    if pg:FindFirstChild("ReactUniversalHotbar") then
        local url = findInShared(getCurrentMap(), getCurrentMode())
        if url then
            runStrat(url)
        else
            log("In-game but no strat found.")
            isRunning = false
        end
        return
    end

    local lastSeenMap  = nil
    local lastVetoTime = 0
    local vetoCount    = 0
    local loopStart    = os.clock()

    while true do
        task.wait(1)

        local mapName  = getCurrentMap()
        local modeName = getCurrentMode()
        log("Check -> " .. tostring(mapName) .. " | " .. tostring(modeName))

        local url = findInShared(mapName, modeName)
        if url then
            log("Match found! Waiting for game...")
            repeat task.wait(0.5) until pg:FindFirstChild("ReactUniversalHotbar")
            task.wait(0.5)
            runStrat(url)
            return
        end

        if not mapName then
            task.wait(1)
            goto loopEnd
        end

        if mapName == lastSeenMap then
            local waited = os.clock() - lastVetoTime
            if waited < 5 then
                log(string.format("Same map '%s' — waiting %.1fs...", mapName, 5 - waited))
                task.wait(5 - waited)
                goto loopEnd
            end
            log("Same map after 5s — re-queueing...")
            local qOk = pcall(function()
                ReplicatedStorage:WaitForChild("RemoteFunction", 10)
                    :InvokeServer("Multiplayer", "v2:start", buildPayload(Config.Mode))
            end)
            if qOk then
                log("v2:start sent.")
                lastSeenMap = nil; lastVetoTime = 0; vetoCount = 0
            else
                log("v2:start failed — hopping...")
                isRunning = false; hop(); return
            end
        else
            log(string.format("No strat for '%s' — vetoing...", mapName))
            pcall(function()
                local ev = ReplicatedStorage:FindFirstChild("RemoteEvent")
                if ev then ev:FireServer("LobbyVoting", "Veto") end
            end)
            lastSeenMap  = mapName
            lastVetoTime = os.clock()
            vetoCount    = vetoCount + 1

            if vetoCount > 3 then
                log("Too many vetoes — re-queueing...")
                local qOk = pcall(function()
                    ReplicatedStorage:WaitForChild("RemoteFunction", 10)
                        :InvokeServer("Multiplayer", "v2:start", buildPayload(Config.Mode))
                end)
                if qOk then
                    log("v2:start sent.")
                    vetoCount = 0; lastSeenMap = nil
                else
                    log("v2:start failed — hopping...")
                    isRunning = false; hop(); return
                end
            end
        end

        if os.clock() - loopStart > 120 then
            log("Timeout — hopping...")
            isRunning = false; hop(); return
        end

        ::loopEnd::
    end
end

