local function buildPayload(mode)
    if mode == "Hardcore" then
        return {mode = "hardcore", difficulty = "Easy", count = 1}
    elseif mode == "Voidcore" then
        return {mode = "hardcore", difficulty = "Hard", count = 1}
    elseif MatchmakingMap[mode] then
