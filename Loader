}

local function buildPayload(mode)
    if mode == "Hardcore" then return {mode="hardcore",difficulty="Easy",count=1}
    elseif mode == "Voidcore" then return {mode="hardcore",difficulty="Hard",count=1}
    elseif MatchmakingMap[mode] then
        local p = {mode=MatchmakingMap[mode],count=1}
        if mode:match("Ducky") then p.difficulty=mode:gsub("Ducky","") end
        return p
    else return {difficulty=mode,mode="survival",count=1} end
end

local function autoReady()
    task.spawn(function()
        local reps = ReplicatedStorage:WaitForChild("StateReplicators")
        local vote = reps:WaitForChild("VoteReplicator")
        repeat task.wait(0.5)
        until vote:GetAttribute("Enabled") == true and vote:GetAttribute("Title") == "Ready?"
        pcall(function() ReplicatedStorage:WaitForChild("RemoteFunction"):InvokeServer("Voting","Skip") end)
        log("Ready sent")
    end)
end

local function startMatchmaking()
    log("Matchmaking: "..Config.Mode)
    local RemoteFunc = ReplicatedStorage:WaitForChild("RemoteFunction")
    local payload = buildPayload(Config.Mode)
    repeat
        local ok, res = pcall(function() return RemoteFunc:InvokeServer("Multiplayer","v2:start",payload) end)
        if ok and (res == true or (type(res)=="table" and res.Success==true) or (type(res)=="userdata")) then
            log("Matchmaking OK"); break
        end
        task.wait(0.5)
    until false
end

local function validateAndRun()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then hop(); return end

    log("Waiting for intermission...")
    local startT = os.clock()
    repeat
        if pg:FindFirstChild("ReactGameIntermission") then break end
        if pg:FindFirstChild("ReactUniversalHotbar") then break end
        task.wait(0.5)
    until (os.clock() - startT > 60)

    if pg:FindFirstChild("ReactUniversalHotbar") then
        local url = findInShared(getCurrentMap(), getCurrentMode())
        if url then runStrat(url) end
        return
    end

    local vetoSent, loopStart = false, os.clock()
    while true do
        task.wait()
        local mapName, modeName = getCurrentMap(), getCurrentMode()
        log("Check -> "..tostring(mapName).." | "..tostring(modeName))
        local url = findInShared(mapName, modeName)
        if url then
            log("Match found!")
            repeat task.wait(0.5) until pg:FindFirstChild("ReactUniversalHotbar")
            task.wait(0.5)
            runStrat(url)
            return
        end
        if not vetoSent then
            log("Not match. Vetoing...")
            pcall(function() ReplicatedStorage.RemoteEvent:FireServer("LobbyVoting","Veto") end)
            vetoSent = true
        else
            log("Restarting v2:start...")
            local ok = pcall(function()
                ReplicatedStorage:WaitForChild("RemoteFunction")
                    :InvokeServer("Multiplayer","v2:start",buildPayload(Config.Mode))
            end)
            if ok then log("v2:start OK."); vetoSent = false
            else log("v2:start failed. Hopping..."); hop(); return end
        end
        if os.clock() - loopStart > 60 then log("Timeout. Hopping..."); hop(); return end
    end
end

