        log("Found " .. #fileURLs .. " .lua files")
    end
    
    -- ถ้าไม่มี Repo หรือหาไม่เจอ ให้ Warn แล้ว Return (ไม่มีวิธี List ไฟล์จาก Raw URL ได้)
    if #fileURLs == 0 then
        warn("[ADS] No files found! Make sure Config.Repo is set correctly.")
        return false
    end
    
    -- ดึงโค้ดจากทุกไฟล์แล้ว Extract
    for _, fileURL in ipairs(fileURLs) do
        local code = nil
        for i = 1, 3 do
            local ok, res = pcall(function() return game:HttpGet(fileURL) end)
            if ok and type(res) == "string" and #res > 50 then
                code = res
                break
            end
            task.wait(1)
        end
        if code then extractFromCode(code, fileURL) end
    end
    
    return true
end

